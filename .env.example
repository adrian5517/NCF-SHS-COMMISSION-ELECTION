# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Any long random string; signs the student kiosk session JWT.
# Generate one: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
STUDENT_SESSION_SECRET=change-me-to-a-long-random-string
