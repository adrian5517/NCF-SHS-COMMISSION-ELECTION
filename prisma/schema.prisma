// Prisma 7 schema for the NCF-SHS election database.
// Connection URLs live in prisma.config.ts (not here) in Prisma 7.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String   @id @db.Uuid
  full_name String   @default("")
  role      String   @default("watcher")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("profiles")
}

model Election {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  description      String    @default("")
  logo_url         String?   @db.Text
  start_date       DateTime  @db.Timestamptz
  end_date         DateTime  @db.Timestamptz
  status           String    @default("draft")
  hide_live_results Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  positions           Position[]
  votingCodes         VotingCode[]
  votes               Vote[]
  abstentions         Abstention[]
  voteTallies         VoteTally[]
  abstentionTallies   AbstentionTally[]

  @@map("elections")
}

model Position {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  election_id          String   @db.Uuid
  position_name        String
  max_votes            Int      @default(1)
  rank_order           Int      @default(0)
  eligible_grade_levels String[]
  plurality_at_large   Boolean  @default(false)

  election          Election          @relation(fields: [election_id], references: [id], onDelete: Cascade)
  candidates        Candidate[]
  votes             Vote[]
  abstentions       Abstention[]
  voteTallies       VoteTally[]
  abstentionTallies AbstentionTally[]

  @@index([election_id, rank_order], map: "positions_election_idx")
  @@map("positions")
}

model Candidate {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  position_id    String  @db.Uuid
  candidate_name String
  grade_level    String  @default("")
  section        String  @default("")
  party_list     String  @default("")
  party_color    String  @default("#16a34a")
  photo_url      String? @db.Text
  motto          String  @default("")
  display_order  Int     @default(0)

  position    Position    @relation(fields: [position_id], references: [id], onDelete: Cascade)
  votes       Vote[]
  voteTallies VoteTally[]

  @@index([position_id, display_order], map: "candidates_position_idx")
  @@map("candidates")
}

model Student {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lrn         String   @unique
  full_name   String
  grade_level String
  section     String
  strand      String   @default("")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  votingCodes VotingCode[]

  @@index([grade_level, section], map: "students_grade_section_idx")
  @@map("students")
}

model VotingCode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id  String   @db.Uuid
  election_id String   @db.Uuid
  code        String
  expires_at  DateTime @db.Timestamptz
  is_used     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  student  Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  election Election @relation(fields: [election_id], references: [id], onDelete: Cascade)

  @@unique([election_id, code])
  @@index([student_id, election_id], map: "voting_codes_student_idx")
  @@map("voting_codes")
}

model Vote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  election_id  String   @db.Uuid
  position_id  String   @db.Uuid
  candidate_id String   @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  election  Election  @relation(fields: [election_id], references: [id], onDelete: Cascade)
  position  Position  @relation(fields: [position_id], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([election_id, position_id, candidate_id], map: "votes_tally_idx")
  @@map("votes")
}

model VoteTally {
  election_id  String @db.Uuid
  position_id  String @db.Uuid
  candidate_id String @db.Uuid
  votes        BigInt @default(0)

  election  Election  @relation(fields: [election_id], references: [id], onDelete: Cascade)
  position  Position  @relation(fields: [position_id], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@id([election_id, candidate_id])
  @@index([election_id, position_id], map: "vote_tallies_position_idx")
  @@map("vote_tallies")
}

model Abstention {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  election_id String   @db.Uuid
  position_id String   @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  election Election @relation(fields: [election_id], references: [id], onDelete: Cascade)
  position Position @relation(fields: [position_id], references: [id], onDelete: Cascade)

  @@index([election_id, position_id], map: "abstentions_tally_idx")
  @@map("abstentions")
}

model AbstentionTally {
  election_id String @db.Uuid
  position_id String @db.Uuid
  abstentions BigInt @default(0)

  election Election @relation(fields: [election_id], references: [id], onDelete: Cascade)
  position Position @relation(fields: [position_id], references: [id], onDelete: Cascade)

  @@id([election_id, position_id])
  @@map("abstention_tallies")
}
